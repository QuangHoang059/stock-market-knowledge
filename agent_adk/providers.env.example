# API keys cho các LLM provider — copy thành providers.env và điền key thật.
# File này đã có trong .gitignore, không commit key thật lên repo.

GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Provider mặc định khi chạy runner không truyền --provider
AGENT_ADK_PROVIDER=claude
