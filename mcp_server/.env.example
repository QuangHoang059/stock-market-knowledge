# Cấu hình MCP server.
# Copy thành `.env` và điền giá trị thật trước khi `docker compose up -d`.
#
# Generate token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8001

# Token bắt buộc cho HTTP mode. Không commit file .env thật!
MCP_AUTH_TOKEN=replace-me-with-random-32-bytes

# Log level cho uvicorn (debug|info|warning|error)
MCP_LOG_LEVEL=info
